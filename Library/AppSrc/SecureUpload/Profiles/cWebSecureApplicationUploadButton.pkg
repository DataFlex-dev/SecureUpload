Use SecureUpload\cWebSecureFileUploadButton.pkg

Class cWebSecureApplicationUploadButton is a cWebSecureFileUploadButton

    Procedure Construct_Object
        Forward Send Construct_Object
        
        Set psAccept to C_SECUP_PROFILE_EXTENSIONS_APPLICATION
        Set pullMaxFileSize to C_SECUP_PROFILE_EXTENSIONS_APPLICATION_MAX_FILE_SIZE
    End_Procedure
    
End_Class
